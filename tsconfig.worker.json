{
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
		"target": "ES2022",
		"lib": ["ES2024"],
		"module": "ESNext",
		"types": [],
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["worker", "worker-configuration.d.ts"]
}
